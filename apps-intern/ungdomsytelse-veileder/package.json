        "playwright-core": "1.64.1",
        "postcss": ">=8.5.28",
        "postcss-styled-syntax": "0.7.4",
        "prettier": "3.9.10",
        "sass-embedded": "1.105.2",
        "storybook": "10.6.2",
        "stylelint": "17.16.0",
        "tailwindcss": "4.3.3",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.2",
        "vite": "8.3.4",
        "vite-plugin-checker": "0.14.5",
        "vitest": "5.0.5"
    },
    "msw": {
        "workerDirectory": [
            "dist",
            ""
        ]
    }
}
