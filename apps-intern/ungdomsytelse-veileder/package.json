{
    "name": "@navikt/ungdomsytelse-veileder",
    "version": "0.10.3",
    "private": true,
    "description": "Midlertidig app for veileder på ungdomsprogramytelsen",
    "license": "MIT",
    "author": "NAV",
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build-storybook": "storybook build",
        "check:types": "tsc --noemit",
        "clean": "rm -rf node_modules dist",
        "demo:build": "pnpm demo:build-app && pnpm demo:copy-app-files",
        "demo:build-app": "vite build --config vite.demo.config.ts",
        "demo:copy-app-files": "cp ./dist-demo/demo/index.html ./dist-demo/index.html && rm -rf ./dist-demo/demo && cp ./mockServiceWorker.js ./dist-demo/",
        "demo:start": "vite preview --base /sif-brukerdialog/ungdomsytelse-veileder --config vite.demo.config.ts",
        "dev": "vite --base=/sif-brukerdialog/ungdomsytelse-veileder --config vite.dev.config.ts --port 8088",
        "dev:debug": "vite --debug",
        "e2e:build": "pnpm pw:build",
        "gh-pages:rebuild": "pnpm demo:build",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "lint:tsc": "tsc --noEmit",
        "playwright-test": "playwright test",
        "pw:build": "pnpm pw:build-app && pnpm pw:copy-mock-service-worker",
        "pw:build-app": "vite build --config vite.playwright.config.ts",
        "pw:copy-mock-service-worker": "cp ./mockServiceWorker.js ./dist-playwright/",
        "pw:run": "playwright test",
        "pw:start": "vite preview --base /sif-brukerdialog/ungdomsytelse-veileder/ --outDir dist-playwright --config vite.playwright.config.ts",
        "storybook": "storybook dev -p 6006",
        "test": "vitest run"
    },
    "dependencies": {
        "@nais/apm": "0.7.3",
        "@navikt/aksel-icons": "8.19.2",
        "@navikt/ds-css": "8.19.2",
        "@navikt/ds-react": "8.19.2",
        "@navikt/ds-tailwind": "8.19.2",
        "@navikt/fnrvalidator": "2.2.1",
        "@navikt/nav-dekoratoren-moduler": "4.5.1",
        "@navikt/sif-common-api": "workspace:*",
        "@navikt/sif-common-core-ds": "workspace:*",
        "@navikt/sif-common-formik-ds": "workspace:*",
        "@navikt/sif-common-ui": "workspace:*",
        "@navikt/sif-common-utils": "workspace:*",
        "@sif/api": "workspace:*",
        "@sif/apm": "workspace:*",
        "@sif/app-register": "workspace:*",
        "@sif/env": "workspace:*",
        "@sif/hooks": "workspace:*",
        "@sif/ung-deltakelse-opplyser-api-veileder": "workspace:*",
        "@sif/validation": "workspace:*",
        "@tanstack/react-query": "5.104.3",
        "axios": "1.20.0",
        "clsx": "2.1.1",
        "constate": "4.0.0",
        "csp-header": "6.4.0",
        "dayjs": "1.11.23",
        "formik": "2.4.9",
        "html-react-parser": "6.1.8",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-intl": "12.1.4",
        "react-loading-skeleton": "3.5.0",
        "react-markdown": "10.1.0",
        "react-router-dom": "7.18.4",
        "remark-gfm": "4.0.1",
        "uuid": "^14.0.2",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.14.0",
        "@eslint/eslintrc": "3.3.7",
        "@eslint/js": "10.0.1",
        "@playwright/test": "1.64.1",
        "@sif/config": "workspace:*",
        "@sif/eslint-config": "workspace:*",
        "@storybook/react-vite": "10.6.2",
        "@tailwindcss/postcss": "4.3.3",
        "@tailwindcss/vite": "4.3.3",
        "@types/node": "26.6.5",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@typescript-eslint/parser": "8.71.2",
        "@vitejs/plugin-react": "6.1.2",
        "@vitest/browser": "5.0.5",
        "@vitest/coverage-v8": "5.0.5",
        "@vitest/eslint-plugin": "1.6.27",
        "compression": "1.8.2",
        "eslint": "10.12.0",
        "eslint-plugin-prettier": "5.5.7",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-simple-import-sort": "14.0.0",
        "eslint-plugin-storybook": "10.6.2",
        "express": "5.3.0",
        "jsdom": "^30.1.3",
        "mockdate": "3.0.5",
        "msw": "2.15.0",
        "msw-storybook-addon": "3.0.3",
