{
    "name": "@sif/soknad-ui",
    "version": "0.2.1",
    "private": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/navikt/sif-brukerdialog.git"
    },
    "type": "module",
    "sideEffects": [
        "**/*.css",
        "./src/components/progress-stepper/ProgressStepper.tsx",
        "./src/components/item-list-darkside/ItemListDarkside.tsx",
        "./src/components/info-list/InfoList.tsx",
        "./src/components/demo-watermark/DemoWatermark.tsx"
    ],
    "exports": {
        ".": "./src/index.ts",
        "./components": "./src/components/index.ts",
        "./hooks": "./src/hooks/index.ts",
        "./lenker": "./src/lenker/index.ts",
        "./i18n": "./src/i18n/index.tsx",
        "./pages": "./src/pages/index.ts",
        "./styles/sif-ds-theme.css": "./src/styles/sif-ds-theme.css",
        "./utils": "./src/utils/index.ts"
    },
    "main": "src/index.ts",
    "types": "src/index.ts",
    "scripts": {
        "build-storybook": "storybook build",
        "lint:eslint": "eslint \"./src/**/*.{js,ts,tsx}\"",
        "lint:fix": "eslint --quiet --fix './src/**/*.{js,ts,tsx}'",
        "lint:tsc": "tsc --noEmit",
        "storybook": "storybook dev -p 6006",
        "test": "vitest run"
    },
    "dependencies": {
        "@navikt/aksel-icons": "8.19.2",
        "@navikt/ds-react": "8.19.2",
        "@navikt/nav-dekoratoren-moduler": "4.5.1",
        "@sif/api": "workspace:*",
        "@sif/env": "workspace:*",
        "@sif/hooks": "workspace:*",
        "@sif/utils": "workspace:*",
        "js-cookie": "3.0.8",
        "react-intl": "12.1.5",
        "react-responsive": "10.0.1"
    },
    "devDependencies": {
        "@navikt/ds-css": "8.19.2",
        "@sif/config": "workspace:*",
        "@sif/eslint-config": "workspace:*",
        "@storybook/addon-a11y": "10.6.2",
        "@storybook/addon-docs": "10.6.2",
        "@storybook/react-vite": "10.6.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "eslint": "10.13.0",
        "eslint-plugin-storybook": "10.6.2",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "storybook": "10.6.2",
        "typescript": "6.0.3",
        "vite": "8.3.4",
        "vitest": "5.0.5"
    },
    "peerDependencies": {
        "react": ">=19",
        "react-dom": ">=19"
    }
}
