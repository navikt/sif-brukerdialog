        "uuid": "^14.0.2"
    },
    "devDependencies": {
        "@sif/config": "workspace:*",
        "@sif/eslint-config": "workspace:*",
        "eslint": "10.12.0",
        "typescript": "6.0.3",
        "vitest": "5.0.4"
    }
