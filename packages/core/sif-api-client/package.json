{
    "name": "@sif/api-client",
    "version": "0.1.0",
    "private": true,
    "description": "Shared browser API client initialization for SIF applications",
    "type": "module",
    "exports": {
        ".": "./src/index.ts"
    },
    "main": "src/index.ts",
    "types": "src/index.ts",
    "scripts": {
        "lint:eslint": "eslint \"./src/**/*.{js,ts,tsx}\"",
        "lint:fix": "eslint --quiet --fix './src/**/*.{js,ts,tsx}'",
        "lint:tsc": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
