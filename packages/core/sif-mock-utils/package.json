{
    "name": "@sif/mock-utils",
    "version": "0.1.0",
    "private": true,
    "description": "Verktøy for mock-oppsett og mock-tilstand i SIF-apper (MSW, Playwright og demo)",
    "type": "module",
    "exports": {
        ".": "./src/index.ts"
    },
    "main": "src/index.ts",
    "types": "src/index.ts",
    "scripts": {
