{
    "include": ["./**/*.ts", "./**/*.tsx"],
    "exclude": ["node_modules", "dist", ".sanity"],
    "compilerOptions": {
        "module": "ESNext",
        "target": "ES2022",
        "lib": ["ES2022", "DOM"],
        "jsx": "react-jsx",
        "moduleResolution": "bundler",
        "noEmit": true,
        "forceConsistentCasingInFileNames": true,
        "noImplicitReturns": true,
        "strict": true,
        "skipLibCheck": true,
        "noUnusedLocals": true
    }
}
