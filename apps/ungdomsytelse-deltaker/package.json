{
    "name": "@navikt/ungdomsytelse-deltaker",
    "version": "1.6.3",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build-storybook": "storybook build",
        "check:types": "tsc --noemit",
        "clean": "rm -rf node_modules dist dist-demo",
        "demo:build": "pnpm demo:build-app && pnpm demo:copy-app-files",
        "demo:build-app": "vite build --config vite.demo.config.ts",
        "demo:copy-app-files": "cp ./dist-demo/demo/index.html ./dist-demo/index.html && rm -rf ./dist-demo/demo && cp ./mockServiceWorker.js ./dist-demo/",
        "demo:start": "vite preview --base /sif-brukerdialog/ungdomsytelse-deltaker/ --config vite.demo.config.ts",
        "dev": "pnpm dev:vite",
        "dev:debug": "vite --debug",
        "dev:vite": "vite --config vite.dev.config.ts",
        "e2e:build": "pnpm pw:build",
        "gh-pages:rebuild": "pnpm demo:build",
        "lint:eslint": "eslint src",
        "lint:fix": "eslint src --fix",
        "lint:tsc": "tsc --noEmit",
        "playwright-test": "playwright test",
        "pw:build": "pnpm pw:build-app && pnpm demo:copy-app-files",
        "pw:build-app": "vite build --config vite.playwright.config.ts",
        "pw:run": "pnpm playwright-test",
        "pw:start": "vite preview --base /ungdomsprogrammet/ytelsen/ --config vite.playwright.config.ts",
        "storybook": "storybook dev -p 6006",
        "test": "vitest run"
    },
